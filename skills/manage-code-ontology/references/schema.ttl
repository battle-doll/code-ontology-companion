@prefix co: <https://battle-doll.github.io/code-ontology-explorer/schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

co:CodeEntity a rdfs:Class ;
    rdfs:label "Code entity" .

co:Container a rdfs:Class ;
    rdfs:subClassOf co:CodeEntity .

co:Callable a rdfs:Class ;
    rdfs:subClassOf co:CodeEntity .

co:FrameworkConcept a rdfs:Class ;
    rdfs:label "Framework concept" .

co:PipelineRole a rdfs:Class ;
    rdfs:label "Pipeline role" .

co:PolicyLeaf a rdfs:Class ;
    rdfs:label "Policy leaf identifier" .

co:RuntimeBranch a rdfs:Class ;
    rdfs:label "Statically identified runtime control branch" .

co:RelationshipEvidence a rdfs:Class ;
    rdfs:label "Bounded static relationship evidence" .

co:OntologyQuality a rdfs:Class ;
    rdfs:label "Ontology quality summary" .

co:AdapterQuality a rdfs:Class ;
    rdfs:label "Language adapter capability summary" .

co:language a rdf:Property ;
    rdfs:domain co:CodeEntity .

co:qualifiedName a rdf:Property ;
    rdfs:domain co:CodeEntity .

co:relativePath a rdf:Property ;
    rdfs:domain co:CodeEntity .

co:relationshipType a rdf:Property .
co:evidencePath a rdf:Property .
co:ruleId a rdf:Property .
co:evidenceBasis a rdf:Property .
co:runtimeStatus a rdf:Property .
co:lineStart a rdf:Property .
co:lineEnd a rdf:Property .
co:limitationId a rdf:Property .
co:contractVersion a rdf:Property .
co:documentedEdges a rdf:Property .
co:missingEvidence a rdf:Property .
co:coveragePercent a rdf:Property .
co:supportStatus a rdf:Property .
co:detected a rdf:Property .
co:capability a rdf:Property .
co:unsupportedRuntime a rdf:Property .
co:hasAdapterQuality a rdf:Property .

co:Declares a rdf:Property .
co:Imports a rdf:Property .
co:Extends a rdf:Property .
co:Implements a rdf:Property .
co:AnnotatedBy a rdf:Property .
co:DecoratedBy a rdf:Property .
co:Injects a rdf:Property .
co:DeclaresBean a rdf:Property .
co:ManagedAs a rdf:Property .
co:MayBeProxiedBy a rdf:Property .
co:Calls a rdf:Property .
co:HasPipelineRole a rdf:Property .
co:ReadsPolicyLeaf a rdf:Property .
co:DeclaresRuntimeBranch a rdf:Property .
co:GuardsRuntimeBranch a rdf:Property .
