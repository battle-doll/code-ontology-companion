{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-ontology:local-source-analysis-access:1",
  "title": "Explicit local source disclosure permission, not semantic review",
  "type": "object",
  "required": [
    "format",
    "purpose",
    "permissionId",
    "sourceFingerprint",
    "scopeDigest",
    "selectedScope",
    "privateDestinationId",
    "profileSha256",
    "aclSha256",
    "revocationId",
    "revoked",
    "expiresAt",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "companion.local-source-analysis-access.v1"
    },
    "purpose": {
      "const": "local-source-analysis"
    },
    "permissionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scopeDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selectedScope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "privateDestinationId": {
      "type": "string",
      "pattern": "^pw-[0-9a-f]{32}$"
    },
    "profileSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "aclSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revocationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "revoked": {
      "type": "boolean"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sourceSha256",
          "tokenByteStart",
          "tokenByteEnd",
          "tokenSha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "tokenByteStart": {
            "type": "integer",
            "minimum": 0
          },
          "tokenByteEnd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          },
          "tokenSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
